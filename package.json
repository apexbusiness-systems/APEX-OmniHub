    "bundle:check": "npm run build && size-limit",
    "build:seo": "node scripts/generate-sitemap.mjs && vite build",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "release": "bun run verify:release && bun run changeset:publish",
    "prebuild": "node scripts/check-env-root.mjs && node scripts/generate-sitemap.mjs",
    "armageddon:certify": "tsx src/scripts/certify-armageddon.ts",
    "armageddon:certify:ci": "tsx src/scripts/certify-armageddon-ci.ts",
    "release:shadow-preflight": "node scripts/ci/shadow-certification-preflight.mjs",
    "release:validation-summary": "node scripts/ci/write-release-validation-summary.mjs",
    "check:release-certification-docs": "node scripts/ci/check-release-certification-docs.mjs",
    "rsi:evidence": "python3 tools/rsi/build_evidence.py",
    "rsi:dry": "RSI_DRY_RUN=1 python3 tools/rsi/build_evidence.py && python3 tools/rsi/policy_engine.py && python3 tools/rsi/decision.py && cat artifacts/rsi/decision.json",
    "rsi:ci": "python3 tools/rsi/build_evidence.py --ci && python3 tools/rsi/policy_engine.py && python3 tools/rsi/decision.py",
    "rsi:test": "python3 -m pytest tests/rsi/ -v --tb=short",
    "verify:types": "tsc -b --noEmit",
    "verify:lint": "bun run lint && bun run lint:py",
    "verify:test": "bun run test:coverage && bun run check:new-code-coverage && bun run test:py",
    "verify:build": "APEX_ALLOW_MISSING_SUPABASE_CONFIG=true bun run build",
    "verify:security": "bun run secret:scan && bun run test:secret-scan && bun run security:audit",
    "verify:assets": "bun run test:assets",
    "verify:supabase-security": "node scripts/ci/verify-supabase-security.mjs",
    "verify:edge-functions": "node scripts/ci/verify-edge-function-existence.mjs",
    "verify:claim-hygiene": "node scripts/ci/verify-claim-hygiene.mjs",
    "verify:armageddon-attestation": "node scripts/ci/verify-armageddon-attestation.mjs",
    "verify:ci-integrity": "node scripts/ci/verify-ci-integrity.mjs",
    "verify:supply-chain": "node scripts/ci/verify-supply-chain.mjs",
    "verify:release": "node scripts/ci/verify-release.mjs",
    "check:pwa": "node scripts/ci/check-pwa-integrity.mjs",
    "check:lockfiles": "node scripts/ci/check-lockfile-sync.mjs",
    "check:lockfile-sync": "node scripts/ci/check-lockfile-sync.mjs",
    "check:accepted-risk": "node scripts/ci/check-accepted-risk.mjs",
    "check:agent-guardrails": "node scripts/ci/guard-agent-destructive-actions.mjs",
    "check:edge-fn-manifest": "node scripts/ci/check-edge-fn-manifest.mjs",
    "check:supabase-env-alignment": "node scripts/ci/verify-supabase-env-alignment.mjs",
    "check:ops-doc-claim-integrity": "node scripts/ci/check-ops-doc-claim-integrity.mjs",
    "check:omnidash": "node scripts/ci/check-omnidash-integrity.mjs",
    "check:omni-skin": "node scripts/ci/check-omni-skin.mjs",
    "check:omniskills-rebrand": "node scripts/ci/check-omniskills-rebrand.mjs",
    "check:coverage-integrity": "node scripts/ci/check-coverage-integrity.mjs",
    "test:secret-scan": "node tests/ci/secret-scan-fixtures.test.mjs",
    "check:new-code-coverage": "node scripts/ci/check-new-code-coverage.mjs",
    "verify:cloudflare-pages-contract": "node scripts/ci/verify-cloudflare-pages-contract.mjs",
    "i18n:check": "node apps/omnihub-site/scripts/i18n-check.mjs && node apps/omnihub-site/scripts/i18n-hardcoded-ui-check.mjs",
