    "apple:secret": "tsx scripts/generate-apple-secret.ts",
    "readiness:generate": "node scripts/generate-readiness-report.mjs",
    "postinstall": "node scripts/patch-capacitor-tar.cjs && node -e \"try{require('child_process').execFileSync(process.platform==='win32'?'sh':'/bin/sh',[require('path').join(__dirname,'scripts','install-githooks.sh')],{stdio:'ignore'})}catch(e){}\"",
