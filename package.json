{
  "name": "apex-omnihub",
  "private": true,
  "version": "1.8.3",
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b --noEmit",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "VITEST_COVERAGE=true vitest run --coverage",
    "test:unit": "vitest run tests/lib",
    "test:integration": "vitest run tests/integration",
    "omni:validate": "vitest run tests/integration/omni-convergence.test.tsx",
    "test:prompt-defense": "vitest run tests/prompt-defense",
    "test:e2e": "APEX_ALLOW_MISSING_SUPABASE_CONFIG=true playwright test",
    "test:e2e:backend": "APEX_E2E_BACKEND_REQUIRED=true APEX_ALLOW_MISSING_SUPABASE_CONFIG=false playwright test",
    "test:e2e:ci": "npx playwright test --project=chromium",
    "test:e2e:install": "playwright install chromium",
    "test:assets": "node tests/smoke/assets-check.mjs",
    "test:infra": "vitest run tests/infrastructure",
    "test:infra:coverage": "VITEST_COVERAGE=true vitest run tests/infrastructure/cloudflare-ratelimit-ruleset.test.ts tests/infrastructure/lambda-dispatch-context-branch.test.ts tests/infrastructure/production-domain-alignment.test.ts packages/infrastructure/tests/lambda-dispatch.test.ts --coverage.include=src/omnihub-gateway/lambdaDispatchActivity.ts --coverage.exclude= --coverage.thresholds.lines=85 --coverage.thresholds.functions=85 --coverage.thresholds.branches=70 --coverage.thresholds.statements=85",
    "check:react": "node scripts/check-react-singleton.mjs",
    "docs:check": "node scripts/ci/check_docs_links.mjs && node scripts/ci/check_doc_code_pointers.mjs",
    "ci:runtime-gates": "node scripts/ci/guard-agent-destructive-actions.mjs && npm run check:lockfiles && npm run check:react && npm run check:pwa && npm run check:omnidash && npm run test:assets && npm run test:infra && npm run test:e2e",
    "smoke-test": "tsx scripts/smoke-test.ts",
    "guardian:status": "tsx scripts/guardian/status.ts",
    "omnilink:health": "tsx scripts/omnilink/health.ts",
    "zero-trust:baseline": "tsx scripts/zero-trust/baseline-cli.ts",
    "dr:test": "tsx scripts/dr/run-dr-test.ts --dry-run",
    "prompt-defense:analyze": "tsx scripts/prompt-defense/analyze_flags.ts",
    "secret:scan": "node scripts/secret-scan.mjs",
    "security:audit": "node -e \"const fs=require('fs');const dir='security';if(!fs.existsSync(dir))fs.mkdirSync(dir,{recursive:true});\" && node -e \"const{execSync}=require('child_process');try{const r=execSync('npm audit --omit=dev --json',{encoding:'utf8'});require('fs').writeFileSync('security/npm-audit-latest.json',r)}catch(e){require('fs').writeFileSync('security/npm-audit-latest.json',e.stdout||'{}')}\"",
    "sim:chaos": "tsx sim/cli.ts --mode chaos",
    "sim:dry": "tsx sim/cli.ts --mode dry",
    "sim:quick": "tsx sim/cli.ts --mode quick",
    "sim:burst": "tsx sim/cli.ts --mode burst",
    "sim:custom": "tsx sim/cli.ts --mode custom",
    "sim:validate": "tsx sim/cli.ts --validate",
    "sim:report": "tsx sim/evidence.ts --report",
    "sim:clean": "node -e \"const fs=require('fs'),p=require('path'),d=p.join(__dirname,'evidence');if(fs.existsSync(d)){fs.readdirSync(d).forEach(f=>{const fp=p.join(d,f);fs.rmSync(fp,{recursive:true,force:true})})}\"",
    "eval:ci": "tsx sim/cli.ts --mode eval",
    "test:sim": "vitest run sim/tests",
    "test:wwwct": "tsx scripts/worldwide-wildcard/run.ts --mode mock",
    "test:wwwct:sandbox": "tsx scripts/worldwide-wildcard/run.ts --mode sandbox",
    "test:wwwct:report": "tsx scripts/worldwide-wildcard/run.ts --mode mock --report-dir tests/worldwide-wildcard/reports",
    "lint:py": "cd orchestrator && ruff check . && ruff format --check .",
    "format:py": "cd orchestrator && ruff format .",
    "test:py": "cd orchestrator && python -m pytest -q",
    "ci:py": "npm run lint:py && npm run test:py",
    "hardhat:compile": "hardhat compile",
    "hardhat:test": "hardhat test",
    "hardhat:node": "hardhat node",
    "hardhat:deploy:local": "hardhat run scripts/hardhat/deploy.ts --network localhost",
    "hardhat:deploy:sepolia": "hardhat run scripts/hardhat/deploy.ts --network sepolia",
    "hardhat:deploy:amoy": "hardhat run scripts/hardhat/deploy.ts --network amoy",
    "hardhat:deploy:mainnet": "node scripts/hardhat/guard-mainnet-deploy.mjs && hardhat run scripts/hardhat/deploy.ts --network mainnet",
    "hardhat:deploy:polygon": "hardhat run scripts/hardhat/deploy.ts --network polygon",
    "hardhat:mint": "hardhat run scripts/hardhat/mint.ts",
    "demo:verify": "tsx apex-resilience/scripts/demo-verify.ts",
    "apex:deploy": "./apex-resilience/scripts/deploy.sh",
    "apex:test": "vitest run apex-resilience/tests/",
